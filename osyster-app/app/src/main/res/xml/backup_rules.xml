<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older. Settings move between phones through Osyster's own export, not Android
    backup, so preference stores, databases (scan and notification history), saved notification pictures, and caches stay out. Keep in sync with data_extraction_rules.xml
    (BackupRulesTest compares them).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="cache" />
    <exclude domain="file" path="logs" />
    <exclude domain="file" path="notification_pictures" />
</full-backup-content>
