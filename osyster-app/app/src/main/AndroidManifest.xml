<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:theme="@style/Theme.Osyster">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Osyster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Day Data Usage Widget -->
        <receiver
            android:name=".widget.DailyDataUsageWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_day_data_usage_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qtremors.osyster.action.REFRESH_DAY_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_data_usage_info" />
        </receiver>

        <!-- Month Data Usage Widget -->
        <receiver
            android:name=".widget.MonthlyDataUsageWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_data_usage_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qtremors.osyster.action.REFRESH_MONTH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_data_usage_info" />
        </receiver>

        <!-- Combined 4x4 Data Usage Widget -->
        <receiver
            android:name=".widget.CombinedDataUsageWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_combined_data_usage_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.qtremors.osyster.action.REFRESH_COMBINED_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_data_usage_info" />
        </receiver>

        <!-- Music Notification Listener Service -->
        <service
            android:name=".widget.music.MusicNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.music.MusicWidgetControlReceiver"
            android:exported="false" />

        <!-- Music 3x3 Circular Widget -->
        <receiver
            android:name=".widget.music.Music3x3WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_3x3_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_3x3_info" />
        </receiver>

        <!-- Music 5x1 Pill Widget -->
        <receiver
            android:name=".widget.music.Music5x1WidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_5x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_5x1_info" />
        </receiver>

    </application>

</manifest>
