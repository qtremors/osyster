<?xml version="1.0" encoding="utf-8"?>
<!-- Today above This month, mobile and Wi-Fi side by side in each. Values auto-size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_day_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_day_title"
                android:textColor="@color/widget_on_card_dim"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="-10dp">

                <ImageView
                    android:id="@+id/widget_btn_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_ripple"
                    android:contentDescription="@string/widget_refresh_description"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/widget_on_card_dim" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateBehavior="repeat"
                    android:indeterminateDrawable="@drawable/widget_refresh_spin"
                    android:indeterminateDuration="700"
                    android:indeterminateTint="@color/widget_accent"
                    android:padding="9dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/network_mobile_label"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_data"
                android:tint="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_today_mobile_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_on_card" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/network_wifi_label"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wifi"
                android:tint="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_today_wifi_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_on_card" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_month_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_month_title"
                android:textColor="@color/widget_on_card_dim"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="-10dp">

                <ImageView
                    android:id="@+id/widget_btn_refresh_month"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_ripple"
                    android:contentDescription="@string/widget_refresh_description"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/widget_on_card_dim" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spin_month"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateBehavior="repeat"
                    android:indeterminateDrawable="@drawable/widget_refresh_spin"
                    android:indeterminateDuration="700"
                    android:indeterminateTint="@color/widget_accent"
                    android:padding="9dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/network_mobile_label"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_data"
                android:tint="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_month_mobile_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_on_card" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/network_wifi_label"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wifi"
                android:tint="@color/widget_on_card" />

            <TextView
                android:id="@+id/widget_month_wifi_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:autoSizeMaxTextSize="26sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0 B"
                android:textColor="@color/widget_on_card" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
