<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".widget.DayDataUsageWidget"
            android:exported="true"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_data_usage_info" />
        </receiver>

        <receiver
            android:name=".widget.MonthDataUsageWidget"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_data_usage_info" />
        </receiver>

        <receiver
            android:name=".widget.CombinedDataUsageWidget"
            android:exported="true"
            android:label="@string/widget_combined_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_data_usage_info" />
        </receiver>
    </application>
</manifest>
