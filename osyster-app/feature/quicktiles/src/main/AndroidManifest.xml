<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color picker: one screen capture, only after the user agrees in Android's own prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <service
            android:name=".RamTile"
            android:exported="true"
            android:icon="@drawable/ic_qt_ram"
            android:label="@string/tile_ram"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".DataTodayTile"
            android:exported="true"
            android:icon="@drawable/ic_qt_data"
            android:label="@string/tile_data_today"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".ColorPickerTile"
            android:exported="true"
            android:icon="@drawable/ic_qt_color"
            android:label="@string/color_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".ColorCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".ColorPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Glance stack widget and the service that feeds its cards. -->
        <receiver
            android:name=".GlanceStackWidget"
            android:exported="false"
            android:label="@string/widgets_glance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glance_stack_info" />
        </receiver>
        <service
            android:name=".GlanceStackService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
