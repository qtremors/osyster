<?xml version="1.0" encoding="utf-8"?>
<!-- Glance: one card holding a list of readings. Every row stays readable at any size; a small
     widget scrolls instead of overlapping rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glance_card_background">

    <ListView
        android:id="@+id/glance_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/glance_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/glance_card_loading"
        android:textColor="@color/glance_on_card"
        android:textSize="14sp" />
</FrameLayout>
