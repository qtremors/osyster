<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glance_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/glance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/glance_accent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/glance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/glance_on_card"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/glance_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/glance_on_card_dim"
        android:textSize="13sp" />
</LinearLayout>
