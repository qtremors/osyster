<?xml version="1.0" encoding="utf-8"?>
<!-- One reading: name and value on a line, the detail under it, and a level bar where it applies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glance_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glance_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/glance_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/glance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/glance_on_card"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/glance_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
            android:maxLines="1"
        android:textColor="@color/glance_on_card_dim"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/glance_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/glance_bar"
        android:visibility="gone" />
</LinearLayout>
