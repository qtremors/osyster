<?xml version="1.0" encoding="utf-8"?>
<!-- A widget key: a tonal pill that ripples on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/remote_widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/remote_widget_track" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
