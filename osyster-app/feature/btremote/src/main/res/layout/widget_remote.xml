<?xml version="1.0" encoding="utf-8"?>
<!-- The Bluetooth remote on the home screen: who is connected, then media and volume keys.
     With nothing connected the keys open the remote instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remote_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/remote_widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/remote_widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/remote_widget_not_connected"
            android:textColor="@color/remote_widget_on_card_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/remote_widget_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/remote_widget_key"
                android:contentDescription="@string/remote_previous"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remote_previous"
                android:tint="@color/remote_widget_on_card" />

            <ImageView
                android:id="@+id/remote_widget_volume_down"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/remote_widget_key"
                android:contentDescription="@string/remote_volume_down"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remote_volume_down"
                android:tint="@color/remote_widget_on_card" />

            <ImageView
                android:id="@+id/remote_widget_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1.3"
                android:background="@drawable/remote_widget_key_main"
                android:contentDescription="@string/remote_play_pause"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remote_play_pause"
                android:tint="@color/remote_widget_on_accent" />

            <ImageView
                android:id="@+id/remote_widget_volume_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/remote_widget_key"
                android:contentDescription="@string/remote_volume_up"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remote_volume_up"
                android:tint="@color/remote_widget_on_card" />

            <ImageView
                android:id="@+id/remote_widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/remote_widget_key"
                android:contentDescription="@string/remote_next"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remote_next"
                android:tint="@color/remote_widget_on_card" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
