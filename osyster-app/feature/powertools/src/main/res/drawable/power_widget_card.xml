<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card, rippling on touch inside its rounded corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/power_widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/power_widget_card" />
            <corners android:radius="@dimen/power_widget_radius" />
        </shape>
    </item>
</ripple>
