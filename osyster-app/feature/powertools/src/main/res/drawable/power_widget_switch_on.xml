<?xml version="1.0" encoding="utf-8"?>
<!-- A switch drawn as a picture: widgets before Android 12 cannot hold a real Switch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="52dp" android:height="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/power_widget_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:width="24dp" android:height="24dp" android:gravity="end|center_vertical" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/power_widget_on_accent" />
        </shape>
    </item>
</layer-list>
