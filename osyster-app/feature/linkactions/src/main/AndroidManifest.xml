<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Shows up as a choice for opening web links. Picking Osyster as the default makes every
             link ask which app to use. -->
        <activity
            android:name=".LinkChooserActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/link_chooser_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Osyster.LinkChooser">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
