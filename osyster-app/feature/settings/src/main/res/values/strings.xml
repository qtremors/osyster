    <string name="privacy_promises">Osyster\'s promises</string>
    <string name="privacy_offline">No internet access</string>
    <string name="privacy_offline_detail">Osyster does not request the internet permission, so it cannot send anything anywhere.</string>
    <string name="privacy_local">Everything stays on your phone</string>
    <string name="privacy_local_detail">No accounts, ads, analytics, or crash reporting. Settings are saved on the device and only leave it if you export them.</string>
    <string name="privacy_identifiers">No permanent identifiers</string>
    <string name="privacy_identifiers_detail">Serial numbers, IMEI, phone numbers, MAC addresses, and DRM device IDs are never read.</string>
    <string name="privacy_permissions">Optional permissions</string>
    <string name="privacy_perm_usage">Usage access</string>
    <string name="privacy_perm_usage_detail">Data usage and screen time. Asked on those tools only.</string>
    <string name="privacy_perm_location">Location</string>
    <string name="privacy_perm_location_detail">Android shows the Wi-Fi network name only to apps with location access. Your location itself is never read.</string>
    <string name="privacy_perm_phone">Phone</string>
    <string name="privacy_perm_phone_detail">Mobile network type and SIM state. Your number, calls, and contacts are never read.</string>
    <string name="privacy_perm_notifications">Notifications</string>
    <string name="privacy_perm_notifications_detail">Shows the Stay awake countdown so you can stop it.</string>
    <string name="privacy_perm_notification_access">Notification access</string>
    <string name="privacy_perm_notification_access_detail">Music widgets and flashlight pulse. Notification text is never stored.</string>
    <string name="privacy_perm_secure_settings">Change system settings</string>
    <string name="privacy_perm_secure_settings_detail">Granted only by you through ADB, Shizuku, or root, for Stay awake while charging and power tools.</string>

