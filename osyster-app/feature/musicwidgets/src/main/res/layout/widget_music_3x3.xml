<?xml version="1.0" encoding="utf-8"?>
<!-- The disc view wraps the square artwork (adjustViewBounds), so the two buttons pinned to its
     corners sit on the edge of the disc at any widget size, not at the corners of the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Osyster.AppWidget">

<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/widget_music_art_disc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_music_disc_placeholder"
        android:contentDescription="@string/widget_music_default_title" />

    <ImageButton
        android:id="@+id/widget_btn_repeat"
        android:layout_width="@dimen/widget_music_corner_button"
        android:layout_height="@dimen/widget_music_corner_button"
        android:layout_alignTop="@+id/widget_music_art_disc"
        android:layout_alignEnd="@+id/widget_music_art_disc"
        android:layout_margin="4dp"
        android:background="@drawable/widget_music_circle_background"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_music_repeat"
        android:contentDescription="@string/widget_music_repeat_desc" />

    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="@dimen/widget_music_corner_button"
        android:layout_height="@dimen/widget_music_corner_button"
        android:layout_alignStart="@+id/widget_music_art_disc"
        android:layout_alignBottom="@+id/widget_music_art_disc"
        android:layout_margin="4dp"
        android:background="@drawable/widget_music_button_background"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_music_play"
        android:contentDescription="@string/widget_music_play_desc" />

</RelativeLayout>

</FrameLayout>
